{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "go: build app",
			"type": "shell",
			"command": "go",
			"args": [
				"build",
				"-o",
				"${workspaceFolder}/cmd/app/app.exe",
				"./cmd/app"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$go"
			],
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}